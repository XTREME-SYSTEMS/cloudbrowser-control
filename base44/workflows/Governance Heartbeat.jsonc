{
  "name": "Governance Heartbeat",
  "description": "5-minute operational validation and reconciliation heartbeat. Inspects worker health, stale sessions, config drift, and logs evidence. Harmless validation is automated; production mutations remain approval-gated.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "governance_heartbeat",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_worker_health": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "engineHealth",
            "args": {}
          },
          "then": "check_stale_sessions",
          "x-base44": {
            "title": "Check worker health",
            "description": "Probe engine and persist health observation"
          }
        }
      },
      {
        "check_stale_sessions": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkSchedules",
            "args": {}
          },
          "then": "reconcile_settings",
          "x-base44": {
            "title": "Check stale sessions",
            "description": "Detect and handle stale sessions and schedules"
          }
        }
      },
      {
        "reconcile_settings": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconcileSettings",
            "args": {
              "action": "reconcile"
            }
          },
          "then": "log_heartbeat",
          "x-base44": {
            "title": "Reconcile settings",
            "description": "Detect and reconcile configuration drift"
          }
        }
      },
      {
        "log_heartbeat": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logAudit",
            "args": {
              "action": "heartbeat",
              "entity_type": "governance",
              "description": "5-minute governance heartbeat completed"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log heartbeat",
            "description": "Record evidence receipt for governance heartbeat"
          }
        }
      }
    ]
  }
}