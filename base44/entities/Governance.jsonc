{
  "name": "Governance",
  "type": "object",
  "properties": {
    "article": {
      "type": "string",
      "description": "Short article name e.g. 'Article I: No Unapproved Production'"
    },
    "principle": {
      "type": "string",
      "description": "The governance principle \u2014 what it requires or forbids"
    },
    "category": {
      "type": "string",
      "enum": [
        "safety",
        "ethics",
        "opsec",
        "charter"
      ],
      "default": "charter"
    },
    "enforcement": {
      "type": "string",
      "description": "How this principle is enforced (block, veto, review, log)"
    },
    "rank": {
      "type": "number",
      "default": 0,
      "description": "Priority rank \u2014 higher = more important"
    }
  },
  "required": [
    "article",
    "principle"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}