{
  "name": "CaptchaSolveLog",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Engine session ID used for the solve attempt"
    },
    "url": {
      "type": "string",
      "description": "Page URL where the captcha was encountered"
    },
    "captcha_type": {
      "type": "string",
      "enum": [
        "recaptcha_v2",
        "hcaptcha",
        "turnstile",
        "unknown"
      ],
      "default": "unknown"
    },
    "provider": {
      "type": "string",
      "enum": [
        "self",
        "2captcha",
        "anticaptcha",
        "capmonster"
      ],
      "default": "self"
    },
    "detected": {
      "type": "boolean",
      "default": false
    },
    "solved": {
      "type": "boolean",
      "default": false
    },
    "token": {
      "type": "string",
      "description": "Solve token (if solved)"
    },
    "error": {
      "type": "string",
      "description": "Error message if solve failed"
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "engine_version": {
      "type": "string"
    },
    "triggered_by": {
      "type": "string",
      "enum": [
        "auto",
        "manual",
        "test"
      ],
      "default": "test"
    }
  },
  "required": [
    "provider",
    "detected",
    "solved"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}