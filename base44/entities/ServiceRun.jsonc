{
  "name": "ServiceRun",
  "type": "object",
  "description": "One production run of a catalogue service: the prompt that drove it, every numbered step and its result, the three independent assurance reviews, and the monitoring signals. Written by runServiceWorkflow.",
  "properties": {
    "service_slug": {
      "type": "string",
      "description": "Catalogue service this run belongs to"
    },
    "service_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "assurance",
        "delivered",
        "blocked",
        "failed"
      ],
      "default": "queued"
    },
    "input_sentence": {
      "type": "string",
      "description": "The plain-language instruction the operator gave"
    },
    "enhanced_prompt": {
      "type": "string",
      "description": "The prompt the run was actually driven by, after enhancement against industry standards"
    },
    "prompt_standard": {
      "type": "string",
      "description": "Which standard the enhancement was built against"
    },
    "steps": {
      "type": "array",
      "description": "Every numbered step with its own status and result",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "skipped",
              "failed"
            ]
          },
          "result": {
            "type": "string"
          },
          "output": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "steps_completed": {
      "type": "number",
      "default": 0
    },
    "steps_total": {
      "type": "number",
      "default": 0
    },
    "producer_summary": {
      "type": "string",
      "description": "What the producing agent actually produced"
    },
    "assurance": {
      "type": "object",
      "description": "The three independent reviews. Each records the model that produced it so independence stays auditable.",
      "properties": {
        "qa": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "score": {
              "type": "number"
            },
            "verdict": {
              "type": "string"
            },
            "failed_rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "guardian": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "allowed": {
              "type": "boolean"
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "validator": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "score": {
              "type": "number"
            },
            "verified": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unverified": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "model_separation_ok": {
          "type": "boolean",
          "description": "True only when producer, QA, guardian and validator used distinct model families"
        }
      }
    },
    "overall_score": {
      "type": "number",
      "default": 0
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "conditional",
        "blocked",
        "failed"
      ],
      "default": "failed"
    },
    "delivery_allowed": {
      "type": "boolean",
      "default": false,
      "description": "False whenever the guardian blocked the run or the score is below threshold"
    },
    "monitoring": {
      "type": "object",
      "description": "Signals the dashboard watches for this run",
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_by_email": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "service_slug",
    "service_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}