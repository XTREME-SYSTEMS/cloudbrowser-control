{
  "name": "CouncilDeliberation",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "description": "What the council was convened to deliberate on"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "watchdog",
        "manual",
        "pre_action",
        "post_action"
      ],
      "default": "manual",
      "description": "What triggered this deliberation"
    },
    "transcript": {
      "type": "string",
      "description": "JSON-stringified debate transcript (author, content, kind entries)"
    },
    "vote_held": {
      "type": "boolean",
      "default": false
    },
    "vote_tally": {
      "type": "string",
      "description": "JSON-stringified vote tally (agent, vote pairs)"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "allow",
        "block",
        "conditional",
        "inconclusive"
      ],
      "default": "inconclusive"
    },
    "resolution": {
      "type": "string",
      "description": "The council's committed decision"
    },
    "foresight": {
      "type": "string",
      "description": "Forward-looking statement for the operator"
    },
    "related_entity_id": {
      "type": "string",
      "description": "ID of the entity record this deliberation governs (SandboxProject, AgentTask, etc.)"
    },
    "related_entity_type": {
      "type": "string",
      "description": "Entity type this deliberation governs"
    },
    "doctrine_id": {
      "type": "string",
      "description": "Doctrine entry extracted from this deliberation (if any)"
    }
  },
  "required": [
    "topic",
    "verdict"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}