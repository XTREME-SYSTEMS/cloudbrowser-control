{
  "name": "Webhook",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "description": "URL to send webhook payloads to"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "job.completed",
          "job.failed",
          "session.created",
          "session.ended",
          "schedule.triggered",
          "change.detected",
          "engine.down",
          "budget.alert"
        ]
      }
    },
    "secret_encrypted": {
      "type": "string",
      "description": "AES-GCM encrypted HMAC signing secret (base64). Never returned to frontend."
    },
    "has_secret": {
      "type": "boolean",
      "default": false,
      "description": "Whether a signing secret is configured (safe for frontend display)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time"
    },
    "last_status": {
      "type": "number"
    },
    "provider": {
      "type": "string",
      "enum": [
        "generic",
        "slack",
        "discord"
      ],
      "default": "generic"
    }
  },
  "required": [
    "name",
    "url"
  ]
}