{
  "name": "Doctrine",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "description": "Short topic label for this compounded insight"
    },
    "insight": {
      "type": "string",
      "description": "The durable, transferable rule or pattern extracted from a council deliberation"
    },
    "category": {
      "type": "string",
      "enum": [
        "safety",
        "ethics",
        "opsec",
        "tactic",
        "resource",
        "compounding"
      ],
      "default": "tactic"
    },
    "source": {
      "type": "string",
      "description": "What triggered this doctrine (councilSession, councilWatchdog, manual)"
    },
    "confidence": {
      "type": "number",
      "default": 50,
      "description": "0-100 confidence in this doctrine"
    },
    "weight": {
      "type": "number",
      "default": 1,
      "description": "Reinforcement weight \u2014 increases when validated by successful outcomes"
    },
    "validated": {
      "type": "boolean",
      "default": false
    },
    "validation_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "topic",
    "insight"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}