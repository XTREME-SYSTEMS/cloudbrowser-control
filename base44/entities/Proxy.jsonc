{
  "name": "Proxy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "server": {
      "type": "string",
      "description": "Proxy server URL (host:port)"
    },
    "username": {
      "type": "string"
    },
    "password_encrypted": {
      "type": "string",
      "description": "AES-GCM encrypted proxy password (base64). Never returned to frontend."
    },
    "has_password": {
      "type": "boolean",
      "default": false,
      "description": "Whether a password is configured (safe for frontend display)"
    },
    "country": {
      "type": "string"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "http",
        "https",
        "socks5"
      ],
      "default": "http"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "rotation_group": {
      "type": "string",
      "description": "Group name for round-robin rotation"
    }
  },
  "required": [
    "name",
    "server"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}